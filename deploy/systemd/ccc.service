# Template: bin/install.sh fills in @CCC_DIR@ (the ccc checkout).
[Unit]
Description=ccc queue daemon (executes queued Claude Code prompts)
After=network-online.target
# Don't start before the filesystem holding ccc is mounted (matters when
# it lives on a separate disk mounted with `nofail`).
RequiresMountsFor=@CCC_DIR@

[Service]
Type=simple
ExecStart=@CCC_DIR@/.venv/bin/ccc-daemon
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
