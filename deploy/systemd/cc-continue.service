[Unit]
Description=CC-continue queue daemon (executes queued Claude Code prompts)
After=network-online.target

[Service]
Type=simple
ExecStart=/home/lukas/DEV/CC-continue/.venv/bin/cc-continue-daemon
Environment=PATH=/home/lukas/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
