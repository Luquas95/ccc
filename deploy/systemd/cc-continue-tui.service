[Unit]
Description=CC-continue TUI, always alive in a persistent tmux session
After=cc-continue.service
RequiresMountsFor=/mnt/AI

[Service]
# The TUI gets its OWN tmux server (`-L cc-continue`), never the user's
# default one. If this unit were the first to start tmux, the default
# server — and with it every other tmux session on the machine — would
# live inside this unit's cgroup, so systemd-oomd picking this unit would
# kill all of them at once (that happened twice).
#
# The unit stays "running" for as long as the tmux session exists: the
# ExecStart script creates the detached session and then just waits on
# it. If the session disappears for any reason (oomd kill, tmux crash,
# `tmux -L cc-continue kill-server`), the script exits non-zero and
# Restart=always brings everything back after RestartSec.
Type=simple
ExecStart=/home/lukas/DEV/CC-continue/bin/cc-continue-tui-supervise.sh
ExecStop=/usr/bin/tmux -L cc-continue kill-session -t cc-continue
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
